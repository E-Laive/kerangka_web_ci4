CI_ENVIRONMENT = production

# Domain lokal kerangka. Nginx diarahkan ke folder public.
app.baseURL = 'https://kerangkaweb.test/'
app.forceGlobalSecureRequests = true
cookie.secure = true

# Koneksi lokal MySQL/MariaDB kerangka.
database.default.hostname = 127.0.0.1
database.default.database = dbkerangka
database.default.username = kerangka_app
database.default.password = 'REPLACE_WITH_RANDOM_APPLICATION_PASSWORD'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
database.default.DBDebug = false

# Ganti dengan nilai acak panjang pada instalasi produksi.
# encryption.key =
